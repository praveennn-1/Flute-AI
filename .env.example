# ==========================================
# Flute AI — Environment Configuration Template
# ==========================================

# Application Settings
VITE_APP_NAME="Flute"
VITE_APP_URL="http://localhost:5173"
VITE_DEFAULT_LANGUAGE="en-US"

# Audio & Formatting Defaults
VITE_AUTO_PUNCTUATION="true"
VITE_REMOVE_FILLERS="true"
VITE_JARGON_ENHANCE="true"
VITE_WHISPER_BOOST_DEFAULT="false"

# Optional Cloud Speech-to-Text & LLM Formatting Keys
# (Leave blank to use 100% free native browser speech recognition)
VITE_GROQ_API_KEY=""
VITE_OPENAI_API_KEY=""

# LLM Formatting Model
VITE_LLM_MODEL="llama-3.1-8b-instant"

# Server Port
PORT=10000

